<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/ink_950" android:layoutDirection="rtl">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingStart="20dp" android:paddingTop="14dp" android:paddingEnd="16dp" android:paddingBottom="12dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ريلز قرآني" android:textColor="@color/mist_100" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="أنشئ وشارك بدون تعقيد" android:textColor="@color/mist_400" android:textSize="12sp" />
        </LinearLayout>
        <TextView android:layout_width="42dp" android:layout_height="42dp" android:background="@drawable/bg_logo" android:gravity="center" android:text="ق" android:textColor="@color/gold_400" android:textSize="22sp" android:textStyle="bold" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#252032" />

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="إنشاء ريلز جديد" android:textColor="@color/mist_100" android:textSize="22sp" android:textStyle="bold" />
                <TextView android:id="@+id/tvProjectBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_badge" android:paddingStart="10dp" android:paddingTop="6dp" android:paddingEnd="10dp" android:paddingBottom="6dp" android:text="مشروع جديد" android:textColor="@color/emerald_500" android:textSize="11sp" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="اختر المحتوى، نسّق المشهد، ثم صدّر فيديو 9:16 جاهزاً للنشر." android:textColor="@color/mist_400" android:textSize="13sp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="265dp" android:layout_marginTop="16dp" android:background="@drawable/bg_preview" android:gravity="center" android:orientation="vertical" android:padding="20dp">
                <TextView android:id="@+id/tvPreviewBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="معاينة الريل · 9:16" android:textColor="@color/gold_400" android:textSize="12sp" />
                <TextView android:id="@+id/tvPreviewVerse" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:gravity="center" android:text="إِنَّ مَعَ الْعُسْرِ يُسْرًا" android:textColor="@color/mist_100" android:textSize="25sp" android:textStyle="bold" />
                <TextView android:id="@+id/tvPreviewMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="سورة الشرح · الآية ٦" android:textColor="@color/mist_400" android:textSize="12sp" />
                <View android:layout_width="120dp" android:layout_height="3dp" android:layout_marginTop="20dp" android:background="@color/emerald_500" />
            </LinearLayout>

            <VideoView android:id="@+id/videoPreview" android:layout_width="match_parent" android:layout_height="420dp" android:layout_marginTop="12dp" android:background="@color/ink_900" android:visibility="gone" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="مسار الإنشاء" android:textColor="@color/mist_100" android:textSize="17sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnRecitation" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="١  ·  اختر السورة والقارئ" android:textColor="@color/mist_100" android:textSize="13sp" app:strokeColor="@color/purple_600" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnAudio" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="٢  ·  أضف التلاوة الصوتية" android:textColor="@color/mist_100" android:textSize="13sp" app:strokeColor="@color/purple_600" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnBackground" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="٣  ·  اختر الخلفية" android:textColor="@color/mist_100" android:textSize="13sp" app:strokeColor="@color/purple_600" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnCustomize" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="٤  ·  خصص القالب والنص" android:textColor="@color/mist_100" android:textSize="13sp" app:strokeColor="@color/purple_600" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton android:id="@+id/btnExport" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="إنتاج الفيديو ومشاركته" android:textColor="@color/ink_950" android:textSize="14sp" android:textStyle="bold" app:backgroundTint="@color/emerald_500" />
            <TextView android:id="@+id/tvStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:text="جاهز لإنتاج فيديو MP4" android:textColor="@color/mist_400" android:textSize="12sp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="قوالب مقترحة" android:textColor="@color/mist_100" android:textSize="17sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="66dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/bg_template_one" android:gravity="center" android:text="نور الفجر" android:textColor="@color/mist_100" android:textSize="12sp" />
                <TextView android:layout_width="0dp" android:layout_height="66dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:layout_weight="1" android:background="@drawable/bg_template_two" android:gravity="center" android:text="سكينة" android:textColor="@color/mist_100" android:textSize="12sp" />
                <TextView android:layout_width="0dp" android:layout_height="66dp" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/bg_template_three" android:gravity="center" android:text="آية اليوم" android:textColor="@color/mist_100" android:textSize="12sp" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:layout_marginBottom="20dp" android:text="التصميم مستوحى من تدفق تطبيقات صناعة الريلز القرآنية: معاينة، اختيار المحتوى، الخلفية، التخصيص، ثم التصدير — من دون نسخ العلامة التجارية أو الأصول." android:textColor="@color/mist_400" android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="70dp" android:background="@color/ink_900" android:gravity="center" android:orientation="horizontal" android:paddingTop="7dp" android:paddingBottom="5dp">
        <LinearLayout android:id="@+id/navHome" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⌂" android:textColor="@color/emerald_500" android:textSize="24sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الرئيسية" android:textColor="@color/emerald_500" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/navProjects" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▦" android:textColor="@color/mist_400" android:textSize="22sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="المشاريع" android:textColor="@color/mist_400" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/navBackgrounds" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="◈" android:textColor="@color/mist_400" android:textSize="22sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الخلفيات" android:textColor="@color/mist_400" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/navSettings" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚙" android:textColor="@color/mist_400" android:textSize="22sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الإعدادات" android:textColor="@color/mist_400" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
